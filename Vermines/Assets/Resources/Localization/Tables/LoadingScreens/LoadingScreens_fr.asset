  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LoadingScreens_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 68e28738469fc1e47894c66d18f8b174, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2431639552
    m_Localized: Proles Caduca
    m_Metadata:
      m_Items: []
  - m_Id: 2570051584
    m_Localized: "Rejet\xE9 par le Royaume des Abeilles,\ncette abomination fait
      trembler\nm\xEAme les plus braves. "
    m_Metadata:
      m_Items: []
  - m_Id: 3979337728
    m_Localized: Dracoleon
    m_Metadata:
      m_Items: []
  - m_Id: 3979337729
    m_Localized: "Cette cr\xE9ature mi-dragon,\nmi-cameleon est au service des\nAbeilles.
      Enrolez-le et vous pourrez\ncopier les effets d'autres partisans."
    m_Metadata:
      m_Items: []
  - m_Id: 4944027648
    m_Localized: Magus Mortis
    m_Metadata:
      m_Items: []
  - m_Id: 4944027649
    m_Localized: "Avide de collecter de nouvelles \xE2mes,\nil saura vous en donner
      au moment\nopportun."
    m_Metadata:
      m_Items: []
  - m_Id: 5397012480
    m_Localized: "Chilosmod\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 5397012481
    m_Localized: "Les Anciens disent qu'il se cache au sein du Royaume sous la forme
      d'un scolopendre. Faites lui des offrandes et jurez de le servir et peut-\xEAtre
      il se montrera."
    m_Metadata:
      m_Items: []
  - m_Id: 5824831488
    m_Localized: Les Abeilles
    m_Metadata:
      m_Items: []
  - m_Id: 5824831489
    m_Localized: "Dirigeantes du Royaumes, sauront-elles se d\xE9fendre face \xE0
      la menace que vous repr\xE9sentez ? Ou se laisseront-elles s\xE9duire par vos
      paroles ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6491725824
    m_Localized: "Guide de Lumi\xE8res"
    m_Metadata:
      m_Items: []
  - m_Id: 6491725825
    m_Localized: "De la famille des Lucioles, le guide de Lumi\xE8re est un v\xE9ritable
      guerrier. Rattachez le \xE0 votre cause pour gagner de nombreuses \xE2mes."
    m_Metadata:
      m_Items: []
  - m_Id: 6814687232
    m_Localized: "Scortoph\xE9l\xE8s"
    m_Metadata:
      m_Items: []
  - m_Id: 6814687233
    m_Localized: "Avide de destruction, Scortoph\xE9l\xE8s attends avec impatience
      d'\xEAtre invoqu\xE9 pour mettre le Royaume \xE0 feu et \xE0 sang."
    m_Metadata:
      m_Items: []
  - m_Id: 7167008768
    m_Localized: Les Abeilles
    m_Metadata:
      m_Items: []
  - m_Id: 7167008769
    m_Localized: Trouvez comment apprivoiser le peuple des Abeilles et faites tomber
      leur Royaume.
    m_Metadata:
      m_Items: []
  - m_Id: 7796154368
    m_Localized: "Belz\xE9rocera"
    m_Metadata:
      m_Items: []
  - m_Id: 7796154369
    m_Localized: "Repr\xE9sentation symbolique du Dieu des cr\xE9atures volantes
      Belz\xE9rocera.\nIl saura vous accompagner dans votre qu\xEAte si vous lui
      pr\xEAtez all\xE9geance."
    m_Metadata:
      m_Items: []
  - m_Id: 8110727168
    m_Localized: Mantislith
    m_Metadata:
      m_Items: []
  - m_Id: 8110727169
    m_Localized: "D\xE9mon f\xE9minin, elle croque les espoirs de vies nouvelles
      et terrorise le Royaume. Gardez votre t\xEAte sur vos \xE9paules, si vous lui
      vouez un culte elle vous donnera une certaine puissance."
    m_Metadata:
      m_Items: []
  - m_Id: 8442077184
    m_Localized: Les Lucioles
    m_Metadata:
      m_Items: []
  - m_Id: 8442077185
    m_Localized: "Actives la nuit, elles vous permettent de rajouter des partisans
      \xE0 la Cour."
    m_Metadata:
      m_Items: []
  - m_Id: 9062834176
    m_Localized: Les Moustiques
    m_Metadata:
      m_Items: []
  - m_Id: 9062834177
    m_Localized: Groupe de mercenaires au service de quiconque pour leurs services.
    m_Metadata:
      m_Items: []
  - m_Id: 9616482304
    m_Localized: Les Cultistes
    m_Metadata:
      m_Items: []
  - m_Id: 9616482305
    m_Localized: "D\xE9sirant ramener \xE0 la vie leurs Dieux Occultes, les Cultistes
      seront pr\xEAts \xE0 tout pour sacrifier des \xE2mes. "
    m_Metadata:
      m_Items: []
  - m_Id: 10157547520
    m_Localized: Les Grillons
    m_Metadata:
      m_Items: []
  - m_Id: 10157547521
    m_Localized: "Votre chant sera-t-il comme celui des Grillons ? Chantez les louanges
      de vos Dieux Occultes et enr\xF4lez des partisans."
    m_Metadata:
      m_Items: []
  - m_Id: 10635698176
    m_Localized: "Les Scarab\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 10635698177
    m_Localized: "Votre parole transperceront-elles la dure carapace des scarab\xE9s
      jusqu'\xE0 leur coeur ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11046739968
    m_Localized: Les Mouches
    m_Metadata:
      m_Items: []
  - m_Id: 11046739969
    m_Localized: "Approchez les avec prudence, elles seront \xE0 votre service si
      vous savez leur parler."
    m_Metadata:
      m_Items: []
  - m_Id: 11428421632
    m_Localized: Les Coccinelles
    m_Metadata:
      m_Items: []
  - m_Id: 11428421633
    m_Localized: 'Symbole de chance, la coccinelle saura vous guider.

      Puissent
      vos paroles vous apporter nombre de partisans.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
